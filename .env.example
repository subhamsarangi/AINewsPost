OPENAI_API_KEY=sk-...

# Database (choose one: local Postgres or Supabase)
DATABASE_URL=postgresql://digest:digest@localhost:5432/digest

# Supabase (optional, replaces DATABASE_URL above if using cloud)
# Get the Postgres connection string from Supabase > Settings > Database > Connection Pooling > Postgres
SUPABASE_DATABASE_URL=

# Cloudflare R2 (PDF storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# models (change here, nowhere else)
EMBED_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-5.4-nano

# pipeline knobs
DIGEST_MAX_ITEMS=5
DEDUP_THRESHOLD=0.82
HN_MIN_POINTS=100
